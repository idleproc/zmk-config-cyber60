#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

// This block tweaks the behavior of layer-tap keys to make them instantly activate 
// the layer if a second key is pressed, removing the sluggish delay for keys like DEL.
&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

/ {
    macros {
        mac_0: mac_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N0 &kp DOT>;
        };
        mac_1: mac_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N1 &kp DOT>;
        };
        mac_2: mac_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N2 &kp DOT>;
        };
        mac_3: mac_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N3 &kp DOT>;
        };
        mac_4: mac_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp N4 &kp DOT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
    &gresc    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp LBKT  &kp RBKT  &kp BSPC
    &kp TAB   &kp SQT   &kp COMMA &kp DOT   &kp P     &kp Y     &kp F     &kp G     &kp C     &kp R     &kp L     &kp FSLH  &kp EQUAL &kp BSLH
    &mo 1     &kp A     &kp O     &kp E     &kp U     &kp I     &kp D     &kp H     &kp T     &kp N     &kp S     &lt 1 MINUS &kp RET
    &kp LSHFT &kp SEMI  &kp Q     &kp J     &kp K     &kp X     &kp B     &kp M     &kp W     &kp V     &kp Z     &kp RSHFT &mo 2
    &kp LCTRL &kp LGUI  &kp LALT                      &kp SPACE                     &kp RALT  &kp K_APP &mo 3
            >;
        };

        layer_1 {
            bindings = <
    &mac_0    &mac_1    &mac_2    &mac_3    &mac_4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp DEL
    &trans    &trans    &kp HOME  &kp UP    &kp END   &kp PG_UP &trans    &trans    &trans    &trans    &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_NUM
    &trans    &kp LSHFT &kp LEFT  &kp DOWN  &kp RIGHT &kp PG_DN &trans    &trans    &trans    &kp KP_N4 &kp KP_N5 &kp KP_N6           &kp RET
    &kp CLCK  &kp LC(C) &kp LC(V) &kp LC(X) &trans    &trans    &trans    &trans    &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp RALT  &trans
    &kp F2    &kp LC(LS(F)) &kp LC(LS(W))             &trans                                  &kp KP_N0 &kp KP_DOT &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
    &kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp DEL
    &trans    &trans    &trans    &kp C_VOL_UP &trans &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp LS(INS)
    &trans    &kp C_MUTE &trans   &kp C_VOL_DN &trans &trans    &trans    &trans    &trans    &trans    &trans    &trans              &trans
    &kp LSHFT &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp RSHFT &trans
    &trans    &trans    &trans                        &trans                                  &trans    &trans    &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
    &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none     &none     &none    &none     &none      &trans    &trans    &bt BT_CLR
    &out OUT_USB  &trans        &trans        &trans        &trans        &trans        &trans    &trans    &trans   &trans    &trans     &trans    &trans    &trans
    &trans        &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &trans &trans &trans &trans
    &trans        &trans        &trans        &trans        &trans        &trans        &trans    &bootloader &trans &trans    &trans     &trans    &trans
    &trans        &trans        &trans                      &trans                                          &trans   &soft_off &trans
            >;
        };

        layer_4 {
            status = "reserved";
        };
    };
};
